{
  "name": "consolium",
  "version": "0.1.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "types": "./distribution/npm/consolium.d.ts",
  "module": "./distribution/npm/consolium.js",
  "main": "./distribution/npm/consolium.js",
  "exports": {
    ".": {
      "types": "./distribution/npm/consolium.d.ts",
      "import": "./distribution/npm/consolium.js"
    },
    "./input": {
      "types": "./distribution/npm/input/api.d.ts",
      "import": "./distribution/npm/input/api.js"
    },
    "./output": {
      "types": "./distribution/npm/output/api.d.ts",
      "import": "./distribution/npm/output/api.js"
    },
    "./formatting": {
      "types": "./distribution/npm/formatting.d.ts",
      "import": "./distribution/npm/formatting.js"
    }
  },
  "author": "Magnus Meseck",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elemental-mind/consolium.git"
  },
  "homepage": "https://github.com/elemental-mind/consolium#readme",
  "scripts": {
    "check": "tsc --noemit",
    "test": "unitium-tsx ./source",
    "visual": "node test/visual/formatting.ts",
    "build:npm": "node project/scripts/build-npm-package.ts",
    "build:jsr": "node project/scripts/build-jsr-package.ts",
    "publish:npm": "git push --follow-tags && node project/scripts/build-npm-package.ts && npm publish",
    "publish:jsr": "git push --follow-tags && node project/scripts/build-jsr-package.ts && cd distribution/jsr && deno publish"
  },
  "files": [
    "distribution/npm",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "unitium": "^0.8.6"
  },
  "dependencies": {
    "apportionium": "^1.0.1"
  }
}
